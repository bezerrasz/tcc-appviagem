# ==========================================
# Configurações do Servidor
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# Configurações do Banco de Dados (MySQL)
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sharearide_db
DB_USER=root
DB_PASSWORD=sua_senha_do_banco
DB_DIALECT=mysql

# ==========================================
# Segurança
# ==========================================
# Chave secreta para assinar os tokens (Obrigatório para o servidor ligar)
JWT_SECRET=sua_chave_secreta_super_segura_aqui_12345

# ==========================================
# Pix da Plataforma (Dono do App)
# ==========================================
# Chave Pix do proprietario do aplicativo para receber a taxa de servico (R$ 2,50 / R$ 5,00)
APP_PIX_RECEBEDOR=Share a Ride (Plataforma)
APP_PIX_CHAVE=sua_chave_pix_do_dono_do_app_aqui

# ==========================================
# Seeder Administrativo
# ==========================================
# Credenciais criadas automaticamente ao rodar o seeder inicial
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@admin.com
ADMIN_SENHA=senha_padrao_admin_123
ADMIN_CPF=00000000000
ADMIN_DATA_NASCIMENTO=1990-01-01